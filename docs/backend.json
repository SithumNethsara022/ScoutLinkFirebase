
{
  "entities": {
    "ScoutProfile": {
      "title": "Scout Profile",
      "description": "Full profile for a scout including badge progress, position, and grade.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "birthday": { "type": "string", "format": "date" },
        "grade": { "type": "number" },
        "subTroop": { "type": "string", "enum": ["Gold I", "Gold II", "Gold III", "Gold IV"] },
        "patrol": { "type": "string" },
        "position": { "type": "string" },
        "role": { "type": "string" },
        "homeAddress": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "parentsNames": { "type": "string" },
        "profilePicUrl": { "type": "string" },
        "awards": {
          "type": "array",
          "items": { "$ref": "#/entities/AwardStatus" }
        },
        "proficiencyBadges": {
          "type": "array",
          "items": { "$ref": "#/entities/ProficiencyBadge" }
        },
        "totalPoints": { "type": "number" },
        "committees": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["name", "email", "birthday", "role"]
    },
    "AwardStatus": {
      "title": "Award Status",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "status": { "type": "string", "enum": ["Not Started", "Test Passing", "Instructor Interview Pending", "Scout Leader Interview Pending", "ADC Interview Pending", "Passed"] },
        "hikeDone": { "type": "boolean" },
        "badgesDone": { "type": "boolean" },
        "passingDate": { "type": "string" }
      }
    },
    "ProficiencyBadge": {
      "title": "Proficiency Badge",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string" },
        "type": { "type": "string", "enum": ["Junior", "Senior"] },
        "category": { "type": "string" },
        "passedDate": { "type": "string" }
      }
    },
    "Notification": {
      "title": "Notification",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "ScoutProfile",
      "description": "Scout user profiles"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "System-wide notifications"
    }
  }
}
