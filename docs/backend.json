
{
  "entities": {
    "ScoutProfile": {
      "title": "Scout Profile",
      "description": "Full profile for a scout including badge progress, position, and grade.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "birthday": { "type": "string", "format": "date" },
        "grade": { "type": "number" },
        "subTroop": { "type": "string" },
        "patrol": { "type": "string" },
        "position": { "type": "string" },
        "role": { "type": "string" },
        "homeAddress": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "parentsNames": { "type": "string" },
        "profilePicUrl": { "type": "string" },
        "onboarded": { "type": "boolean" },
        "totalPoints": { "type": "number" },
        "awards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "status": { "type": "string" }
            }
          }
        }
      },
      "required": ["name", "email", "birthday", "role"]
    },
    "Notification": {
      "title": "Notification",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "ScoutProfile",
      "description": "User profiles"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "System-wide notifications"
    }
  }
}
